{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lekkertaal",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    { "pattern": "lekkertaal.ronanconnolly.dev", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lekkertaal_db",
      "database_id": "ca05c5b2-512c-4007-88a6-b2499e4cbd12",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TTS_CACHE",
      "bucket_name": "lekkertaal-tts"
    },
    {
      // AI-SDK-7: image-input vocab drills. Stores PNGs generated via
      // `/ro:generate-image` (Nano Banana 2). The bucket should be fronted
      // by a public custom domain (e.g. images.lekkertaal.dev) so the React
      // drill component can <img src> directly without a Worker proxy.
      "binding": "IMAGES",
      "bucket_name": "lekkertaal-images"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "SENTRY_DSN": "",
    "POSTHOG_PROJECT_KEY": "",
    "POSTHOG_INGEST_HOST": "https://eu.i.posthog.com",
    "CLERK_PUBLISHABLE_KEY": "pk_test_dml0YWwtbW9sbHktNTkuY2xlcmsuYWNjb3VudHMuZGV2JA",
    "VITE_CLERK_PUBLISHABLE_KEY": "pk_test_dml0YWwtbW9sbHktNTkuY2xlcmsuYWNjb3VudHMuZGV2JA",
    "LOG_LEVEL": "info",
    // Clerk user ids granted admin access to admin-only routes (e.g. /styleguide,
    // the design system). Comma-separated. ronan8642@gmail.com on the
    // vital-molly-59 instance. See requireAdminClerkId() in auth-helper.ts.
    "ADMIN_CLERK_IDS": "user_3DghhWjFjmC5OL9cd0xgvBOrDO6",
    // ElevenLabs is deprecated for this app: the Wikimedia Commons -> OpenAI
    // free stack covers the curriculum. The secret + code stay in place so
    // flipping this to "true" re-enables EL as a synth fallback in /api/tts.
    "ELEVENLABS_ENABLED": "false"
  }
}
